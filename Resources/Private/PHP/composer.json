{
    "config": {
        "vendor-dir": "Composer",
        "allow-plugins": {
            "cweagans/composer-patches": true
        },
        "preferred-install": {
            "*": "dist"
        }
    },
    "require": {
        "respect/rest": "^0.6.0",
        "cweagans/composer-patches": "~1.0"
    },
    "extra": {
        "patches": {
            "respect/rest": {
                "patch for https://github.com/Respect/Rest/issues/144": "patches/issue-144.patch",
                "Add method signature information for rector": "patches/add-information-for-rector.patch"
            }
        },
        "composer-exit-on-patch-failure": true
    }
}
